# Copy real values into Deno Deploy environment settings; never commit real secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
TRACK_REQUEST_HASH_SALT=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_24_CHARACTERS

# Existing Supabase Auth projects, used only to verify moderator access tokens.
BTV_SUPABASE_URL=https://YOUR-BTV-PROJECT.supabase.co
BTV_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
RTV_SUPABASE_URL=https://YOUR-RTV-PROJECT.supabase.co
RTV_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional. Leave empty until Discogs API credentials are configured.
DISCOGS_TOKEN=
